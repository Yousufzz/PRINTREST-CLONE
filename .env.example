# ==============================================================================
# Pinterest Clone Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# Unsplash API Access Key (Get one at https://unsplash.com/developers)
UNSPLASH_KEY=your_unsplash_access_key_here

# Optional: Server Port (defaults to 5000 if not specified)
PORT=5000
