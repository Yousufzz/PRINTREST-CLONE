# ==============================================================================
# Git Ignore Configuration - Pinterest Clone
# Protects private data, credentials, environment variables, and local runtime files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (NEVER COMMIT TO GITHUB)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing template/example environment file for reference
!.env.example

# ------------------------------------------------------------------------------
# 2. Private Database & User Data (Protects user passwords, hashes, salts & profiles)
# ------------------------------------------------------------------------------
/backend/data/*.json
backend/data/*.json
backend/data/users.json
data/*.json
*.sqlite
*.sqlite3
*.db

# Preserve directory structure in Git without committing private data
!backend/data/.gitkeep
!backend/data/.gitignore

# ------------------------------------------------------------------------------
# 3. Dependencies & Package Cache
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 4. Logs, Debugging & Runtime Output
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Temporary Files, Caches & Uploads
# ------------------------------------------------------------------------------
tmp/
temp/
.cache/
backend/uploads/
uploads/

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 7. IDE, Editor & Workspace Settings
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
